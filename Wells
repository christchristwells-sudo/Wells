emplois :
  construire:
    fonctionne sous : ubuntu-latest
    délai d'expiration (minutes) : 30
    mesures:
      - utilise : actions/setup-java@v4
        avec:
          distribution : témurine
          version de Java : "17"

      - utilise : gradle/actions/setup-gradle@v4
        avec:
          version de Gradle : « 8.7 »

      - nom : Créer le projet Android
        environnement :
          NOM_DE_L'APPLICATION : ${{ inputs.app_name }}
          URL_APP: ${{ inputs.app_url }}
        exécuter : |
          mkdir -p app/src/main/java/com/webwrap/app app/src/main/res/values app/src/main/res/mipmap-xxxhdpi

          chat > settings.gradle <<'EOF'
          Gestion des plugins {
            dépôts {
              Google()
              mavenCentral()
              gradlePluginPortal()
            }
          }
          Gestion de la résolution des dépendances {
            dépôts {
              Google()
              mavenCentral()
            }
          }
          rootProject.name = "WebWrap"
          inclure ':app'
          EOF

          cat > build.gradle <<'EOF'
          plugins {
            id 'com.android.application' version '8.5.0' appliquer faux
          }
          EOF

          chat > gradle.properties <<'EOF'
          org.gradle.jvmargs=-Xmx2g
          android.useAndroidX=false
          EOF

          cat > app/build.gradle <<'EOF'
          plugins {
            id 'com.android.application'
          }
          Android {
            espace de noms 'com.webwrap.app'
            compileSdk 34
            defaultConfig {
              applicationId (project.findProperty('appId') ?: 'com.wells.pad')
              minSdk 24
              targetSdk 34
              versionCode 1
              versionName '1.0'
            }
            compileOptions {
              sourceCompatibility JavaVersion.VERSION_17
              targetCompatibility JavaVersion.VERSION_17
            }
          }
          EOF

          cat > app/src/main/AndroidManifest.xml <<'EOF'
          <?xml version="1.0" encoding="utf-8"?>
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">
            <uses-permission android:name="android.permission.INTERNET" />
            <application
              android:icon="@mipmap/ic_launcher"
              android:label="@string/app_name"
              android:theme="@style/AppTheme"
              android:usesCleartextTraffic="false">
              <activité
                android:name=".MainActivity"
                android:exported="true"
                android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
                <filtre d'intention>
                  <action android:name="android.intent.action.MAIN" />
                  <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>
              </activité>
            </application>
          </manifeste>
          EOF

          cat > app/src/main/res/values/styles.xml <<'EOF'
          <?xml version="1.0" encoding="utf-8"?>
          <ressources>
            <style name="AppTheme" parent="android:Theme.DeviceDefault.NoActionBar">
              <item name="android:statusBarColor">#0d0e10</item>
              <item name="android:navigationBarColor">#0d0e10</item>
              <item name="android:windowBackground">#0d0e10</item>
            </style>
          </ressources>
          EOF

          cat > app/src/main/java/com/webwrap/app/MainActivity.java <<'EOF'
          package com.webwrap.app;

          importer android.app.Activity;
          importer android.content.Intent;
          importer android.net.Uri;
          importer android.os.Bundle;
          importer android.webkit.WebChromeClient;
          importer android.webkit.WebResourceRequest;
          importer android.webkit.WebSettings;
          importer android.webkit.WebView;
          importer android.webkit.WebViewClient;

          public class MainActivity extends Activity {
            WebView privé web;

            @Outrepasser
            protected void onCreate(Bundle state) {
              super.onCreate(état);
              web = nouveau WebView(this);
              définirContentView(web);
              WebSettings s = web.getSettings();
              s.setJavaScriptEnabled(true);
              s.setDomStorageEnabled(true);
              s.setMediaPlaybackRequiresUserGesture(false);
              s.setCacheMode(WebSettings.LOAD_DEFAULT);
              final String home = getString(R.string.app_url);
              final String homeHost = Uri.parse(home).getHost();
              web.setWebViewClient(new WebViewClient() {
                @Outrepasser
                public boolean devraitOverrideUrlLoading(WebView v, WebResourceRequest r) {
                  Uri u = r.getUrl();
                  si (u.getHost() != null && u.getHost().equals(homeHost)) retourner faux ;
                  essayer {
                    démarrerActivité(nouvel Intent(Intent.ACTION_VIEW, u));
                  } catch (Exception e) { }
                  renvoyer vrai ;
                }
              });
              web.setWebChromeClient(new WebChromeClient());
              si (état == nul) {
                web.loadUrl(home);
              } autre {
                web.restaurerÉtat(état);
              }
            }

            @Outrepasser
            protected void onSaveInstanceState(Bundle out) {
              super.onSaveInstanceState(out);
              web.saveState(out);
            }

            @Outrepasser
            public void onBackPressed() {
              si (web.canGoBack()) {
                web.goBack();
              } autre {
                super.onBackPressed();
              }
            }
          }
          EOF

